---
import astroLogo from '../assets/astro.svg';
import background from '../assets/background.svg';
import pfp from '../assets/pfp.jpg';
import Header from './Header.astro';


---

<div id="container" class="container">
	<!-- <img id="background" src={background.src} alt="" fetchpriority="high" /> -->
	<main>
		<Header />
		<div class="row justify-content-start align-items-start pb-5">
			<div class="col-lg-5 col-sm-12">
				<div class="brick p-3">
					<h1>
						Experience
					</h1>
					<h2 class="">Research Engineer - Arctura Inc</h2>
					<small>2021-Present</small>
					<p>Collaborates on research funded by DOE SBIR, NSF STTR, and DOE ARPA-E grants.</p>
					<ul>
						<li><strong><a href="/my-work#lightning-protection">Lightning Protection Coating for Wind Turbines</a></strong>: Supported validation tests in a high voltage test facility. Helped plan out pilot studies on wind farms. Helped set up lightning triggered cameras to capture strikes hitting coated turbines.</li>
						<li><strong><a href="/my-work#wind-tunnel">Active Lift Control for Wind Turbine Blades</a></strong>: Developed and tested methods for active lift control using plasma actuators. Tested small scale actuators in an in office lab using high voltage systems and monitoring devices. Built a small scale wind tunnel to visualize actuators with flow.</li>
						<li><strong>Decarbonizing Nitric Acid:</strong> Researches and develops ways to produce NOx using plasma in a lab environment. Works with a spectrometer and NOx analyzer to measure efficiency of the process. Works on report writing and proposal work.</li>
					</ul>
				</div>
			</div>
			<div class="col-lg-4 col-sm-12">
				<div class="brick p-3">
					<h1>
						Education
					</h1>
					<h2 class="mb-3">West Virginia University</h2>
					<p>Graduated in 2021 with a B.S. in Mechanical and Aerospace Engineering and a minor in German.</p>
					<ul>
						<li><strong>Final GPA:</strong> 3.96</li>
						<li><strong>Activities and societies:</strong> <a href="/my-work#AIAA">Presented at AIAA 2022 Region I Student Conference</a>, Honors College, German Club and National Honor Society, SWE, URC, Study Abroad at Kapito Sprachschule, OSTEM</li>
					</ul>
					<hr>
					<h2 class="mb-3">2024 GRFP Submission</h2>
					<p>Recieved Honorable Mention in my GRFP submission in 2024.</p>
					<a href="/my-work#GRFP">View my submission</a>
				</div>
			</div>
			<div class="col-lg-3 col-sm-12">
				<div class="brick p-3">
					<h1>
						Skills
					</h1>
					<ul>
						<li><strong>Languages:</strong> Python, MATLAB</li>
						<li><strong>Software:</strong> SolidWorks, Fusion 360, ANSYS Fluent, XFLR5, Microsoft Office Suite</li>
						<li><strong>Other:</strong> Plasma Physics, High Voltage Systems, Wind Turbine Technology, Data Analysis and Acquisition, Troubleshooting</li>
					</ul>
				</div>
			</div>

			
			<section id="links">
			</section>
		
	</main>
</div>

<style>
	li {
		margin-bottom: 10px;
	}
	h2 {
		margin: 0;
	}
	small {
		display: block;
		margin-bottom: 1em;
	}
	@media screen and (max-width: 768px) {
		.brick {
			margin: 20px;
		}
	}
</style>
