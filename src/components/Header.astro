---
import astroLogo from '../assets/astro.svg';
import background from '../assets/background.svg';
import pfp from '../assets/lizzy.jpeg';


---

		<div class="row justify-content-end align-items-start mb-5 mt-4">
			<div class="col-md-4 pfp">
				<img src={pfp.src} />
			</div>
			<div class="col-3 col-xs-5 d-flex flex-column align-items-end links-wrapper">
				<div class=" links text-end mb-2 ps-2">
					<ul class="list-unstyled">
						<li><a href="/"><span class="d-sm-inline">Home</span> <i class="d-none d-sm-inline fa-solid fa-home"></i></a></li>
					</ul>
				</div>
				<div class="justfy-content-end links text-end mb-2 ps-2">
					<ul class="list-unstyled">
						<li><a href="/my-work"><span class="d-sm-inline">My work</span> <i class="d-none d-sm-inline fa-solid fa-bolt"></i></a></li>
					</ul>
				</div>
				<div class=" links text-end mb-2 ps-2">
					<ul class="list-unstyled">
						<li><a href="/cv"><span class="d-sm-inline">My Resume</span> <i class="d-none d-sm-inline fa-solid fa-download"></i></a></li>
					</ul>
				</div>
				<div class="justfy-content-end links text-end mb-2 ps-2">
					<ul class="list-unstyled">
						<li><a href="https://www.linkedin.com/in/elizabeth-matthews-12a4b4146/" target="_blank"><span class="d-sm-inline">My Profile</span> <i class="d-none d-sm-inline fa-brands fa-linkedin"></i></a></li>
					</ul>
				</div>
			</div>
			<div class="col-9 col-md-5 col-xs-7 ps-0">
				<div class="brick p-3">
					<h1>
						Elizabeth (Lizzy) Matthews
					</h1>
					<p>I graduated from West Virginia University in 2021, with dual degrees in Mechanical and Aerospace Engineering and a minor in German Language. Since graduating, I have worked as a Research Engineer at Arctura, Inc in Rhode Island. At Arctura, I have worked on various grant funded projects, including a <a href="/my-work#lightning-protection">lightning protection coating</a> for wind turbines, <a href="/my-work#wind-tunnel">active lift control</a> for wind turbines, and a <a href="/my-work#AIAA">green nitric acid production method.</a></p>
				</div>
				
			</div>
		</div>
		
		

<style>
	.brick {
		border-radius: 0px 10px 10px 10px;
	}
	a {
		font-weight: bold;
	}
	.pfp img {
		margin: auto;
		display: block;
		max-width: 100%;
		max-height: 260px;
		border-radius: 30% 50% 30% 60%;
		border: 8px solid #4384dd;
	}

	@media screen and (max-width: 768px) {
		.brick {
			margin-right: 20px;
		}
		.pfp {
			margin-bottom: 20px;
		}
	}
	
</style>
