---
import cv from '../assets/Resume_MatthewsElizabeth.pdf';
import Header from './Header.astro';




---

<div id="container" class="container">
	<!-- <img id="background" src={background.src} alt="" fetchpriority="high" /> -->
	<main>
		<Header />
		<h1 class="text-center mb-4">
			My Resume
		</h1>
		<div class="row mb-5">
			<div class="col-lg-12 col-sm-12">
					<div class="d-flex flex-column gap-3 p-3">
						<div class='d-flex flex-row justify-content-around pdf-viewer'>
							<object data={cv} style="width:700px; height:800px; max-width: 100%; "></object>
						</div>
					</div>
			</div>
		</div>
		
	</main>
</div>

<style>
	.pdf-viewer {
		margin-bottom: 50px;
	}
</style>