---
import actuator from '../assets/velocity_profile_2.jpg';
import drawing from '../assets/windtunnel-drawing.jpg';
import windtunnel from '../assets/windtunnel.jpg';
import windtunnelirl from '../assets/windtunnel-irl.jpg';
import lightning from '../assets/lightning.jpeg';
import lightning2 from '../assets/lightning2.jpeg';
import lightning3 from '../assets/lightning3.jpeg';
import aiaareport from '../assets/Comparing_Configurations_of_Multiple_Array_Plasma_Actuators_by_Velocity_and_Flow_Visualization.pdf';
import aiaappt from '../assets/aiaapresentation_v1.pptx.pdf';
import Header from './Header.astro';
import grfp from '../assets/grfp.pdf';
---

<div id="container" class="container">
	<!-- <img id="background" src={background.src} alt="" fetchpriority="high" /> -->
	<main>
		<Header />
		<h1 class="text-center mb-4">My work</h1>
		<div class="container mb-5">
			<div class="row justify-content-center">
				<div class="col-lg-10 col-sm-12 brick p-3 mb-5">
					<h2 id="wind-tunnel" class="">Wind Tunnel</h2>
					<div class="d-flex flex-column gap-3 p-3">
						<div class='d-flex flex-row justify-content-between'>
							<p>I built a windtunnel in collaboration with an intern at Arctura to take Schlieren images of a plasma actuator with flow</p>
						</div>
						<div class='d-flex flex-row justify-content-around flex-wrap gap-3'>
							<img src={actuator.src} alt="Wind Tunnel" style="max-width:40%; height:auto; border-radius: 0px; border: 0px solid #ccc;" />
							<img src={windtunnel.src} alt="Wind Tunnel" style="max-width:40%; height:auto; border-radius: 0px; border: 0px solid #ccc;" />
							<img src={drawing.src} alt="Wind Tunnel" style="max-width:40%; height:auto; border-radius: 0px; border: 0px solid #ccc;" />
							<img src={windtunnelirl.src} alt="Wind Tunnel" style="max-width:40%; height:auto; border-radius: 0px; border: 0px solid #ccc;" />
						</div>
					</div>
				</div>
				<div class="row brick p-3 mb-5">
					<h2 id="lightning-protection" class="">Lightning Protection Coating</h2>
					<div class="d-flex flex-column gap-3 p-3">
						<div class='d-flex flex-row gap-3'>
							<p>We tested our lightning protection coating in the field, we set up cameras on the wind farm to monitor lightning strikes on turbines. We did not get any strikes on a turbine, but got some neat looking photos of lightning nearby</p>
						</div>
						<div class='d-flex flex-row justify-content-around'>
							<img src={lightning.src} alt="Wind Tunnel" style="max-width:30%; height:auto; border-radius: 5px; border: 2px solid #ccc;" />
							<img src={lightning2.src} alt="Wind Tunnel" style="max-width:30%; height:auto; border-radius: 5px; border: 2px solid #ccc;" />
							<img src={lightning3.src} alt="Wind Tunnel" style="max-width:30%; height:auto; border-radius: 5px; border: 2px solid #ccc;" />
						</div>
					</div>
				</div>
				<div class="grfp row col-lg-10 brick p-3 mb-5">
					<h2 id="GRFP" class="">2024 GRFP Submission</h2>
					<div class='pdf-viewer'>
						<object data={grfp} width="500" height="800" >
							<p><a href={grfp} target="_blank">View my report.</a>
							</p>
						</object>
					</div>
				</div>
				<div class="row col-lg-10 col-sm-12 justify-content-center brick p-3 mb-5">
					<h2 id="AIAA" class="">AIAA</h2>
					<div class="d-flex flex-column gap-3 p-3">
						<div class='d-flex flex-row'>
							<p><b>My submission for the AIAA conference</b>, "Comparing Configurations of Multiple Array Plasma Actuators by Velocity and Flow Visualization"</p>
						</div>
						<div class='pdf-viewer'>
							<object data={aiaareport} width="800" height="500" >
								<p><a href={aiaareport} target="_blank">View my report.</a>
								</p>
							</object>
						</div>
						<div class='d-flex flex-row mt-5'>
							<p><b>My powerpoint presentation</b>, presented at the AIAA conference</p>
						</div>
						<div class='pdf-viewer'>
							<object type='application/pdf' data={aiaappt} width="800" height="500">
								<p><a href={aiaappt} target="_blank">View my powerpoint presentation.</a>
								</p>
							</object>
						</div>
					</div>
				</div>
			</div>
		</div>
		
	</main>
</div>

<style>
	.pdf-viewer object {
		width: 100%;
		aspect-ratio: 4 / 3;
	}
	.grfp .pdf-viewer object {
		width: 100%;
		aspect-ratio: 3 / 4;
	}
</style>
